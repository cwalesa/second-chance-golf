{
  "name": "second-chance-golf",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cap:sync": "npm run build && npx cap sync",
    "cap:ios": "npm run cap:sync && npx cap open ios",
    "e2e": "node e2e/run.cjs",
    "perf": "node e2e/perf.cjs",
    "perf:matrix": "node e2e/perf-matrix.cjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.0",
    "playwright": "^1.49.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@capacitor/core": "^6.1.0",
    "@capacitor/ios": "^6.1.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0"
  },
  "description": "Little Links: build a golf course hole by hole. An iPhone game (Capacitor + iOS), playable in the browser while in development."
}
